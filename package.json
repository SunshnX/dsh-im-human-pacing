{
  "name": "dsh-im-human-pacing",
  "version": "1.0.0",
  "type": "module",
  "description": "把 IM 回复拆成多条，并按真人打字与看消息的节奏逐条发送。 Split one IM reply into several human-paced chat bubbles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunshnX/dsh-im-human-pacing.git"
  },
  "homepage": "https://github.com/SunshnX/dsh-im-human-pacing#readme",
  "bugs": {
    "url": "https://github.com/SunshnX/dsh-im-human-pacing/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "im",
    "wechat",
    "weixin",
    "chatbot"
  ],
  "main": "./index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/pacing.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
